# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python service artifacts (services/paddle_ocr, services/pymupdf_layout) — never commit a
# local venv or its generated caches.
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
coverage/
.coverage
htmlcov/

# Local environment/configuration files. Keep an intentional template if one is added.
.env
.env.*
!.env.example

# Personal/copyrighted papers must not be committed. The two small synthetic PDF fixtures
# under tests/fixtures/pdf are intentional repository test data.
*.pdf
!tests/fixtures/pdf/*.pdf

# Local model weights/checkpoints are downloaded separately and are not repository assets.
*.onnx
*.pdmodel
*.pdiparams
*.pth
*.pt

# Benchmark run output (regenerated by `npm run benchmark`)
benchmark/results/*
!benchmark/results/.gitkeep

# Session-local Claude Code state (machine/session-specific, not part of the project)
.claude/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
